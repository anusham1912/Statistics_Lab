                    text.setAttribute('fill', 'var(--text-muted)');
                    text.textContent = k;
                    g.appendChild(text);
                }
            });

            svg.setAttribute('viewBox', `0 0 ${width} ${height}`);
            svg.appendChild(g);
        }

        function loadGeometricExercise() {
            document.getElementById('geom-p').value = 0.5;
            document.getElementById('geom-k-pmf').value = 3;
            document.getElementById('geom-k-cdf').value = 3;
            updateGeometric();
        }

        // Initial setup on load
        window.onload = function() {
            updateBinomial();
        };
    </script>
