            if (!valid) return;

            document.getElementById('geom-params-display').innerText = `p = ${p}`;

            // Statistics
            const mean = 1 / p;
            const variance = (1 - p) / (p * p);
            const stdDev = Math.sqrt(1 - p) / p;
            const secondMoment = (2 - p) / (p * p);
            const skewness = p === 1 ? "Undefined" : ((2 - p) / Math.sqrt(1 - p)).toFixed(4);

            document.getElementById('geom-stat-mean').innerText = mean.toFixed(4);
            document.getElementById('geom-stat-var').innerText = variance.toFixed(4);
            document.getElementById('geom-stat-std').innerText = stdDev.toFixed(4);
            document.getElementById('geom-stat-moment').innerText = secondMoment.toFixed(4);
            document.getElementById('geom-stat-skew').innerText = skewness;

            // PMF
            let kPmf = parseInt(kPmfInput.value);
