        /* ==================== GEOMETRIC MODULE ==================== */
        function geometricPMF(p, k) {
            if (k < 1) return 0;
            return Math.pow(1 - p, k - 1) * p;
        }

        function updateGeometric() {
            const pInput = document.getElementById('geom-p');
            const kPmfInput = document.getElementById('geom-k-pmf');
            const kCdfInput = document.getElementById('geom-k-cdf');
            const pErr = document.getElementById('geom-p-error');
