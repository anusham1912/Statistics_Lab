        /* ==================== POISSON MODULE ==================== */
        function poissonPMF(lambda, k) {
            if (k < 0) return 0;
            if (lambda === 0) return k === 0 ? 1 : 0;
            let logProb = -lambda + k * Math.log(lambda) - logFactorial(k);
            return Math.exp(logProb);
        }

