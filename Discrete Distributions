        /* Helper Math Functions */
        function factorial(n) {
            if (n < 0) return 0;
            if (n === 0 || n === 1) return 1;
            let result = 1;
            for (let i = 2; i <= n; i++) result *= i;
            return result;
        }

        function logFactorial(n) {
            let res = 0;
            for (let i = 2; i <= n; i++) res += Math.log(i);
            return res;
        }

        function combination(n, k) {
            if (k < 0 || k > n) return 0;
            if (k === 0 || k === n) return 1;
            if (k > n / k) k = n - k;
            let c = 1;
            for (let i = 1; i <= k; i++) {
                c = c * (n - (k - i)) / i;
            }
            return Math.round(c);
        }

        function logCombination(n, k) {
            if (k < 0 || k > n) return -Infinity;
            if (k === 0 || k === n) return 0;
            return logFactorial(n) - logFactorial(k) - logFactorial(n - k);
        }

        /* Tooltip handling */
        const tooltip = document.getElementById('chart-tooltip');
        function showTooltip(evt, text) {
            tooltip.innerHTML = text;
            tooltip.style.display = 'block';
            tooltip.style.left = (evt.pageX + 10) + 'px';
            tooltip.style.top = (evt.pageY - 30) + 'px';
        }
        function hideTooltip() {
            tooltip.style.display = 'none';
        }

        /* ==================== BINOMIAL MODULE ==================== */
        function binomialPMF(n, p, k) {
            if (k < 0 || k > n) return 0;
            if (p === 0) return k === 0 ? 1 : 0;
            if (p === 1) return k === n ? 1 : 0;
            let logProb = logCombination(n, k) + k * Math.log(p) + (n - k) * Math.log(1 - p);
            return Math.exp(logProb);
        }

        function updateBinomial() {
            const nInput = document.getElementById('binom-n');
            const pInput = document.getElementById('binom-p');
            const kPmfInput = document.getElementById('binom-k-pmf');
            const kCdfInput = document.getElementById('binom-k-cdf');

            const nErr = document.getElementById('binom-n-error');
            const pErr = document.getElementById('binom-p-error');
            const kPmfErr = document.getElementById('binom-k-pmf-error');
            const kCdfErr = document.getElementById('binom-k-cdf-error');

            let n = parseInt(nInput.value);
            let p = parseFloat(pInput.value);

            let valid = true;
            if (isNaN(n) || n <= 0 || n > 100) { nErr.style.display = 'block'; valid = false; } else { nErr.style.display = 'none'; }
            if (isNaN(p) || p < 0 || p > 1) { pErr.style.display = 'block'; valid = false; } else { pErr.style.display = 'none'; }

            if (!valid) return;

            document.getElementById('binom-params-display').innerText = `n = ${n}, p = ${p}, 1-p = ${(1-p).toFixed(2)}`;

            // Statistics
            const mean = n * p;
            const variance = n * p * (1 - p);
            const stdDev = Math.sqrt(variance);
            const secondMoment = variance + (mean * mean);
            const skewness = variance === 0 ? "Undefined" : ((1 - 2 * p) / stdDev).toFixed(4);

            document.getElementById('binom-stat-mean').innerText = mean.toFixed(4);
            document.getElementById('binom-stat-var').innerText = variance.toFixed(4);
            document.getElementById('binom-stat-std').innerText = stdDev.toFixed(4);
            document.getElementById('binom-stat-moment').innerText = secondMoment.toFixed(4);
            document.getElementById('binom-stat-skew').innerText = skewness;

            // PMF Calculator
            let kPmf = parseInt(kPmfInput.value);
            if (isNaN(kPmf) || kPmf < 0 || kPmf > n) {
                kPmfErr.style.display = 'block';
                document.getElementById('binom-pmf-result').innerText = `P(X = k) = Invalid k`;
            } else {
                kPmfErr.style.display = 'none';
                let prob = binomialPMF(n, p, kPmf);
                document.getElementById('binom-pmf-result').innerText = `P(X = ${kPmf}) = ${prob.toFixed(4)} (${(prob*100).toFixed(2)}%)`;
            }

            // CDF Calculator
            let kCdf = parseInt(kCdfInput.value);
            if (isNaN(kCdf) || kCdf < 0 || kCdf > n) {
                kCdfErr.style.display = 'block';
                document.getElementById('binom-cdf-result').innerText = `Cumulative Probability = Invalid k`;
            } else {
                kCdfErr.style.display = 'none';
                let cdf = 0;
                for (let i = 0; i <= kCdf; i++) cdf += binomialPMF(n, p, i);
                let ccdf = 1 - cdf;
                document.getElementById('binom-cdf-result').innerText = `P(X <= ${kCdf}) = ${cdf.toFixed(4)} | P(X > ${kCdf}) = ${ccdf.toFixed(4)}`;
            }

            renderBinomialGraph(n, p, mean);
        }

