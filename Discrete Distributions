                kPmfErr.style.display = 'block';
                document.getElementById('geom-pmf-result').innerText = `P(X = k) = Invalid k`;
            } else {
                kPmfErr.style.display = 'none';
                let prob = geometricPMF(p, kPmf);
                document.getElementById('geom-pmf-result').innerText = `P(X = ${kPmf}) = ${prob.toFixed(4)} (${(prob*100).toFixed(2)}%)`;
            }

            // CDF
            let kCdf = parseInt(kCdfInput.value);
            if (isNaN(kCdf) || kCdf < 1) {
                kCdfErr.style.display = 'block';
                document.getElementById('geom-cdf-result').innerText = `Cumulative Probability = Invalid k`;
